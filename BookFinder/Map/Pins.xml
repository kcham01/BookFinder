<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://www.blizzard.com/wow/ui/ ..\FrameXML\UI.xsd">
	<!-- BookFinder's world map pin: an icon with a soft glow behind it. Its behaviour is BookFinderMapPinMixin
	     (Map/WorldMap.lua); the map's canvas creates these through AcquirePin. -->
	<Frame name="BookFinderMapPinTemplate" mixin="BookFinderMapPinMixin" virtual="true" enableMouse="true">
		<Size x="16" y="16"/>
		<Layers>
			<Layer level="BACKGROUND">
				<Texture parentKey="Glow" alpha="0.55">
					<Anchors><Anchor point="CENTER"/></Anchors>
				</Texture>
			</Layer>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnMouseEnter"/>
			<OnLeave method="OnMouseLeave"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>
	<!-- The patrol paths of the NPCs a map marks: one pin over the whole canvas holding the lines (BookFinderPathPinMixin,
	     Map/Paths.lua). It never takes the mouse. -->
	<Frame name="BookFinderPathPinTemplate" mixin="BookFinderPathPinMixin" virtual="true" enableMouse="false">
		<Scripts>
			<OnLoad method="OnLoad"/>
		</Scripts>
	</Frame>
	<!-- A map pin of the player's (or shared with them): BookFinderUserPinMixin (Map/UserPins.lua). A friend or guild
	     member who shares their place, and a zone's badge of who is there: Map/People.lua. -->
	<Frame name="BookFinderUserPinTemplate" mixin="BookFinderUserPinMixin" virtual="true" enableMouse="true">
		<Size x="24" y="24"/>
		<Layers><Layer level="ARTWORK"><Texture parentKey="Icon" setAllPoints="true"/></Layer></Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnMouseEnter"/>
			<OnLeave method="OnMouseLeave"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>
	<Frame name="BookFinderPersonPinTemplate" mixin="BookFinderPersonPinMixin" virtual="true" enableMouse="true">
		<Size x="14" y="14"/>
		<Layers><Layer level="ARTWORK"><Texture parentKey="Icon" setAllPoints="true"/></Layer></Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnMouseEnter"/>
			<OnLeave method="OnMouseLeave"/>
		</Scripts>
	</Frame>
	<Frame name="BookFinderZoneBadgeTemplate" mixin="BookFinderZoneBadgeMixin" virtual="true" enableMouse="true">
		<Size x="18" y="18"/>
		<Layers><Layer level="ARTWORK"><Texture parentKey="Icon" setAllPoints="true"/></Layer></Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnMouseEnter"/>
			<OnLeave method="OnMouseLeave"/>
		</Scripts>
	</Frame>
	<!-- A library book: the book's own icon, a route step number when the route is on. BookFinderBookPinMixin
	     (Books/Map.lua). -->
	<Frame name="BookFinderBookPinTemplate" mixin="BookFinderBookPinMixin" virtual="true" enableMouse="true">
		<Size x="20" y="20"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture parentKey="Icon" setAllPoints="true"/>
			</Layer>
			<Layer level="OVERLAY">
				<FontString parentKey="Step" inherits="NumberFontNormalSmall">
					<Anchors><Anchor point="BOTTOMRIGHT" x="3" y="-3"/></Anchors>
				</FontString>
			</Layer>
		</Layers>
		<Scripts>
			<OnLoad method="OnLoad"/>
			<OnEnter method="OnMouseEnter"/>
			<OnLeave method="OnMouseLeave"/>
			<OnMouseUp method="OnMouseUp"/>
		</Scripts>
	</Frame>
</Ui>
